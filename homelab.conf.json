  },
  "bitbake-setup": {
    "configurations": [
      {
        "name": "homelab",
        "description": "Home Lab Linux for Raspberry Pi",
        "setup-dir-name": "homelab-whinlatter",
        "bb-layers": [
          "openembedded-core/meta",
          "meta-yocto/meta-poky",
          "meta-openembedded/meta-oe",
          "meta-arm/meta-arm",
          "meta-arm/meta-arm-toolchain",
          "meta-raspberrypi"
        ],
        "bb-layers-file-relative": [
          "layers/meta-homelab",
          "layers/meta-rpi-optee"
        ],
        "oe-fragments-one-of": {
          "machine": {
            "description": "Target machines",
            "options": [
              {
                "name": "machine/raspberrypi4-64",
                "description": "Raspberry Pi 4"
              },
              {
                "name": "machine/raspberrypi4-64-optee",
                "description": "Raspberry Pi 4 with OP-TEE"
              }
            ]
          },
          "distro": {
            "description": "Target distributions",
            "options": [
              {
                "name": "distro/homelab",
                "description": "Home Lab Linux"
              }
            ]
          }
        }
      }
    ]
  },
  "version": "1.0"
}
